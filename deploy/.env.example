# ── Production Configuration ──
APP_ENV=prod
DEBUG=false
SECRET_KEY=change-this-to-a-random-secret
DB_PASSWORD=change-this-to-a-strong-password
CORS_ORIGINS=["https://yourdomain.com"]

# ── PostgreSQL ──
DATABASE_URL=postgresql+asyncpg://testplatform:${DB_PASSWORD}@postgres:5432/testplatform
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_ECHO=false

# ── Redis ──
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50

# ── MinIO ──
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=testplatform
MINIO_SECRET_KEY=testplatform123
MINIO_BUCKET=testplatform
MINIO_SECURE=false

# ── Celery ──
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── XXL-Job (optional) ──
XXL_JOB_ADMIN_URL=
XXL_JOB_APPNAME=test-platform

# ── Log ──
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
