# ============================================================
# Test Platform — 环境变量配置示例
# 复制为 .env 并修改
# ============================================================

# Flask 密钥（生产环境必须修改）
SECRET_KEY=change-this-in-production

# PostgreSQL 连接
DB_USER=testplatform
DB_PASSWORD=testplatform
DB_HOST=localhost
DB_PORT=5432
DB_NAME=testplatform
DATABASE_URI=postgresql://testplatform:testplatform@localhost:5432/testplatform

# Redis 连接
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# 数据库连接池
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# 文件路径
UPLOAD_FOLDER=./uploads
LOG_FOLDER=./logs
