# ── 本机生产环境配置（PostgreSQL + Redis）──
APP_ENV=prod
DEBUG=false
SECRET_KEY=prod_7f3b9c2e5a1d8f4b6c0e2d4a8f1b3c5e7d9a0b2c4e6f8a1d3b5c7e9f0a2b4d6
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── PostgreSQL（本机 Postgres.app）──
DATABASE_URL=postgresql+asyncpg://testplatform:testplatform123@localhost:5432/testplatform
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Redis（本机 brew）──
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_DB=0
REDIS_CACHE_DB=0
REDIS_PUBSUB_DB=0

# ── MinIO（本机暂未安装，后端自动降级本地存储）──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=testplatform
MINIO_SECRET_KEY=testplatform123
MINIO_BUCKET=testplatform
MINIO_SECURE=false

# ── Celery ──
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── XXL-Job (optional) ──
XXL_JOB_ADMIN_URL=
XXL_JOB_APPNAME=test-platform

# ── Log ──
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
UPLOAD_FOLDER=uploads
