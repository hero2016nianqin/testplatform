# ── 开发环境配置 ──
APP_ENV=dev
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-prod
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── PostgreSQL ──
DATABASE_URL=postgresql+asyncpg://testplatform:testplatform@localhost:5432/testplatform
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=true

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── MinIO ──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=testplatform
MINIO_SECRET_KEY=testplatform123
MINIO_BUCKET=testplatform
MINIO_SECURE=false

# ── Celery ──
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── XXL-Job ──
XXL_JOB_ADMIN_URL=http://localhost:8080/xxl-job-admin
XXL_JOB_APPNAME=test-platform

# ── Log ──
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log
